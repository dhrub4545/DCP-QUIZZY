# ====================================================================
# DCP-QUIZZY Backend Environment Configuration (.env.example)
# ====================================================================

# Port configuration (Defaults to 5000)
PORT=5000

# MongoDB Connection URI (Atlas Cluster or local MongoDB)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/dcp_quizzy?retryWrites=true&w=majority

# JWT Secret for Session Authentication & API Protection
JWT_SECRET=your_super_secret_jwt_key_here

# Primary Google Gemini AI API Key (from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Multi-Key Gemini Rotation pool for high throughput (GEMINI_API_KEY_1 to _20)
# GEMINI_API_KEY_1=your_gemini_api_key_1
# GEMINI_API_KEY_2=your_gemini_api_key_2

# Cloudinary Credentials for Question & Explanation Image Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
