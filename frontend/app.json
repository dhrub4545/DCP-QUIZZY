{
  "expo": {
    "name": "QUIZZY",
    "slug": "quizzy",
    "version": "2.1.3",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#ffffff",
    "icon": "./assets/icon.png",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "web": {
      "bundler": "metro",
      "favicon": "./assets/icon.png"
    },
    "android": {
      "versionCode": 7,
      "backgroundColor": "#ffffff",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.dhrub4545.quizzy"
    },
    "ios": {
      "supportsTablet": true,
      "backgroundColor": "#ffffff",
      "bundleIdentifier": "com.dhrub4545.quizzy"
    },
    "extra": {
      "eas": {
        "projectId": "740787c2-e30c-4d52-b9fb-f5e0a918a765"
      }
    },
    "owner": "dhrub4545",
    "plugins": [
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/icon.png",
          "imageWidth": 160
        }
      ]
    ]
  }
}
