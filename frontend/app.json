{
  "expo": {
    "name": "QUIZZY",
    "slug": "quizzy",
    "version": "2.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0f172a",
    "icon": "./assets/icon.png",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "web": {
      "bundler": "metro",
      "favicon": "./assets/icon.png"
    },
    "android": {
      "versionCode": 3,
      "backgroundColor": "#0f172a",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0f172a"
      },
      "package": "com.dhrub4545.quizzy"
    },
    "ios": {
      "supportsTablet": true,
      "backgroundColor": "#0f172a",
      "bundleIdentifier": "com.dhrub4545.quizzy"
    },
    "extra": {
      "eas": {
        "projectId": "740787c2-e30c-4d52-b9fb-f5e0a918a765"
      }
    },
    "owner": "dhrub4545",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "plugins": [
      "expo-status-bar"
    ]
  }
}
